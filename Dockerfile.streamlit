# Dockerfile for Streamlit Application
# Using uv for dependency management

FROM python:3.12-slim

WORKDIR /app

# Install uv system-wide so it is on PATH for the next RUN steps
# (--user would install it in /root/.local/bin, which is not on PATH)
RUN pip install --no-cache-dir uv

# Copy project files
COPY pyproject.toml uv.lock .

# Sync dependencies into /app/.venv
RUN uv sync --frozen

# Use the venv binaries directly (no uv at runtime)
ENV PATH="/app/.venv/bin:$PATH"

# Copy application code
COPY streamlit_app/ ./streamlit_app/

# Create non-root user for security. No recursive chown on /app/.venv:
# the process only reads the venv (root-owned files are world-readable),
# and a chown -R over tens of thousands of files adds minutes to the build.
RUN groupadd -r appuser && useradd -r -m -g appuser appuser
# -m: create /home/appuser (owned by the user) so Streamlit can write
# its session/installation files; usage stats are disabled below.
ENV STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
USER appuser

# Set environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Expose port
EXPOSE 8501

# Run Streamlit
CMD ["streamlit", "run", "streamlit_app/app.py", "--server.port=8501", "--server.address=0.0.0.0"]
